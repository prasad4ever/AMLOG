# Copy to .env on your own machine and choose a password there.
# Docker Compose reads .env. The Python application does not.
# .env is gitignored. Do not put a real password in this example or in source control.

POSTGRES_USER=amlog
POSTGRES_PASSWORD=
POSTGRES_DB=amlog

AMLOG_ENVIRONMENT=local
AMLOG_DATABASE_URL=
AMLOG_LOG_LEVEL=INFO
AMLOG_MIGRATIONS_DIR=
